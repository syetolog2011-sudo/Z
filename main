import asyncio
import logging
import os
import re
import aiohttp
from dotenv import load_dotenv
from telethon import TelegramClient, events
from telethon.sessions import StringSession
from telethon.network.connection import ConnectionTcpAbridged

load_dotenv()

logging.basicConfig(
    format='[%(levelname) 5s/%(asctime)s] %(name)s: %(message)s',
    level=logging.WARNING
)

# Чтение переменных окружения
API_ID = os.getenv('API_ID')
API_HASH = os.getenv('API_HASH')
BOT_TOKEN = os.getenv('BOT_TOKEN')
SESSION_STRING = os.getenv('SESSION_STRING')

if not all([API_ID, API_HASH, BOT_TOKEN, SESSION_STRING]):
    raise ValueError("ОШИБКА: Проверьте переменные окружения (API_ID, API_HASH, BOT_TOKEN, SESSION_STRING)!")

API_ID = int(API_ID)

SOURCE_CHANNEL = 'kazan_bpla_716'
TARGET_CHANNEL = '@Radat21'
RADAR_CHANNEL_LINK = 'https://t.me/Radat21'

ALERT_KEYWORDS = [
    'фиксаци', 'зафиксирован', 'зафиксированн', 'засекли', 'засек', 
    'обнаружен', 'обнаружени', 'замечен', 'наблюдает', 'направлени', 'курс на',
    'борт', 'бортовой', 'номер', 'позывн', 'цель', 'объект',
    'бпла', 'дрон', 'беспилотник', 'шахед', 'геран', 'ракета',
    'тревог', 'сирен', 'опасност', 'атака', 'взрыв', 'пво', 'отбой', 'прилет', 'сбит'
]

ALLOWED_REGIONS = [
    'м-7', 'м7', 'м-12', 'м12', 'а-151', 'а151', 'р-178', 'р178',
    'чуваш', 'чебоксар', 'новочебоксар', 'канаш', 'алатыр', 'шумерл', 'цивильск',
    'кугес', 'батырев', 'ибрес', 'умар', 'ямбулат', 'козловк', 'мариинский посад',
    'ядрин', 'порецк', 'комсомольск', 'шемурш', 'красноармейск', 'красные четаи', 'аликов',
    'нижегород', 'нижний новгород', 'дзержинск', 'арзамас', 'саров', 'кстов', 
    'бор', 'павлов', 'выкс', 'балахн', 'заволжь', 'богородск', 'кулебак', 
    'городец', 'семенов', 'лысков', 'сергач', 'шахунь', 'навашин', 'лукоянов',
    'ульяновск', 'димитровград', 'инз', 'барыш', 'новоульяновск', 'сенгилей', 
    'чердаклы', 'ишеевк', 'кузоватов', 'карсун', 'майн', 'николаевк', 'сурск',
    'мордови', 'саранск', 'рузаевк', 'ковылкин', 'комсомольск', 'зубова полян', 
    'краснослободск', 'чамзинк', 'ардатов', 'торбеев', 'лямбир', 'инсар',
    'саратов', 'энгельс', 'балаков', 'балашов', 'вольск', 'пугачев', 'ртищев', 
    'маркс', 'петровск', 'аткарск', 'красноармейск', 'ершов', 'калининск',
    'татарстан', 'казан', 'набережные челн', 'нижнекамск', 'альметьевск', 
    'зеленодольск', 'бугульм', 'елабуг', 'лениногорск', 'чистопол', 'заинск'
]

JUNK_PHRASES = [
    r'наш канал', r'подпишись на канал', r'подписывайся',
    r'ссылка в описании', r'источник:', r'читать далее', r'подробнее тут'
]

# Авторизация по сохраненной строке сессии без запроса телефона
client = TelegramClient(
    StringSession(SESSION_STRING),
    API_ID,
    API_HASH,
    connection=ConnectionTcpAbridged,
    connection_retries=None,
    retry_delay=3,
    auto_reconnect=True,
    timeout=20
)

def clean_and_check(text: str) -> str | None:
    if not text:
        return None
    text_lower = text.lower()

    has_number_tag = bool(re.search(r'(?:№\s*\d+|#\s*\d+|борт\s*\d+|цель\s*\d+)', text_lower))
    has_alert_word = any(alert in text_lower for alert in ALERT_KEYWORDS)
    if not (has_alert_word or has_number_tag):
        return None

    if not any(place in text_lower for place in ALLOWED_REGIONS):
        return None

    text = re.sub(r'https?://\S+|www\.\S+|t\.me/\S+', '', text, flags=re.IGNORECASE)
    text = re.sub(r'@[a-zA-Z0-9_]+', '', text)
    text = re.sub(r'(\+7|8)[\s\-\(]*\d{3}[\s\-\)]*\d{3}[\s\-]?\d{2}[\s\-]?\d{2}', '', text)

    for phrase in JUNK_PHRASES:
        text = re.sub(phrase, '', text, flags=re.IGNORECASE)

    lines = [re.sub(r'[ \t]+', ' ', line).strip() for line in text.split('\n')]
    cleaned_text = '\n'.join([line for line in lines if line]).strip()
    return cleaned_text if cleaned_text else None

async def send_via_bot(text: str, media_path: str = None, is_video: bool = False):
    final_text = f"{text}\n\n<a href=\"{RADAR_CHANNEL_LINK}\">Радар Чувашии</a>"
    async with aiohttp.ClientSession() as session:
        if media_path and os.path.exists(media_path):
            method = "sendVideo" if is_video else "sendPhoto"
            field_name = "video" if is_video else "photo"
            url = f"https://api.telegram.org/bot{BOT_TOKEN}/{method}"
            data = aiohttp.FormData()
            data.add_field("chat_id", TARGET_CHANNEL)
            data.add_field("caption", final_text)
            data.add_field("parse_mode", "HTML")
            data.add_field(field_name, open(media_path, "rb"))
            await session.post(url, data=data)
        else:
            url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage"
            payload = {
                "chat_id": TARGET_CHANNEL,
                "text": final_text,
                "parse_mode": "HTML",
                "disable_web_page_preview": True
            }
            await session.post(url, json=payload)

@client.on(events.NewMessage(chats=SOURCE_CHANNEL))
async def handler(event):
    raw_text = event.message.message or ""
    cleaned = clean_and_check(raw_text)
    if cleaned:
        media_path = None
        is_video = False
        try:
            if event.message.media:
                media_path = await event.message.download_media(file="temp_media")
                if event.message.video:
                    is_video = True
            await send_via_bot(cleaned, media_path=media_path, is_video=is_video)
        finally:
            if media_path and os.path.exists(media_path):
                os.remove(media_path)

async def main():
    await client.start()
    print("Бот успешно запущен на сервере и начал мониторинг!")
    await client.run_until_disconnected()

if __name__ == '__main__':
    asyncio.run(main())
