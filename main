    # Фиксация и наблюдение
    'фиксаци', 'зафиксирован', 'зафиксированн', 'засекли', 'засек',
    'обнаружен', 'обнаружени', 'замечен', 'наблюдает', 'направлени', 'курс на',
    # Типы угроз
