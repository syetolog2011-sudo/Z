]

# Фразы, которые вырезаются из текста
JUNK_PHRASES = [
    r'наш канал',
    r'подпишись на канал',
    r'подписывайся',
    r'ссылка в описании',
    r'источник:',
    r'читать далее',
    r'подробнее тут',
    r'срочные новости в'
]

client = TelegramClient(
    'session_radar',
    API_ID,
    API_HASH,
    connection_retries=None,
    retry_delay=3,
    auto_reconnect=True,
    timeout=15
)


def clean_and_check(text: str) -> str | None:
    if not text:
        return None

    text_lower = text.lower()

    # 1. Проверяем наличие маркера тревоги / угрозы / фиксации
    if not any(alert in text_lower for alert in ALERT_KEYWORDS):
        return None

    # 2. Проверяем географическую привязку
    if not any(place in text_lower for place in ALLOWED_REGIONS):
        return None

    # 3. Удаляем веб-ссылки
    text = re.sub(r'https?://\S+|www\.\S+|t\.me/\S+', '', text, flags=re.IGNORECASE)

    # 4. Удаляем юзернеймы
    text = re.sub(r'@[a-zA-Z0-9_]+', '', text)

    # 5. Вырезаем мусорные фразы
    for phrase in JUNK_PHRASES:
        text = re.sub(phrase, '', text, flags=re.IGNORECASE)

    # 6. Очищаем пробелы и пустые строки
    lines = [re.sub(r'[ \t]+', ' ', line).strip() for line in text.split('\n')]
    cleaned_text = '\n'.join([line for line in lines if line]).strip()

    return cleaned_text if cleaned_text else None


@client.on(events.NewMessage(chats=SOURCE_CHANNEL))
async def handler(event):
    raw_text = event.message.message or ""
    print(f"\n[+] Сообщение из @{SOURCE_CHANNEL} (ID: {event.message.id})")

    processed_text = clean_and_check(raw_text)

    if processed_text:
        print("[*] Зафиксировано совпадение (цель/фиксация + регион). Отправка в @Radat21...")
        final_text = f"{processed_text}\n\n[Радар Чувашии]({RADAR_CHANNEL_LINK})"

        try:
            if event.message.media:
                await client.send_file(
                    TARGET_CHANNEL,
                    event.message.media,
                    caption=final_text,
                    parse_mode='md'
                )
            else:
                await client.send_message(
                    TARGET_CHANNEL,
                    final_text,
                    parse_mode='md'
                )
            print("[✓] Опубликовано!")
        except Exception as err:
            print(f"[!] Ошибка отправки: {err}")
    else:
        print("[-] Пропущено (нет фиксации/угрозы или нужного населенного пункта)")


async def main():
    await client.start()
    print("=" * 45)
    print("Бот запущен. Мониторинг фиксаций и угроз активен!")
    print(f"Источник: t.me/{SOURCE_CHANNEL}")
    print(f"Цель: t.me/{TARGET_CHANNEL}")
    print("=" * 45)
    await client.run_until_disconnected()


if __name__ == '__main__':
    asyncio.run(main())
